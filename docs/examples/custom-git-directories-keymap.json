{
  "context": "Workspace",
  "bindings": {
    // Default git directory scanner (scans ~/git)
    "alt-cmd-g": ["projects::OpenGitDirectory", { "create_new_window": false }],

    // Custom single git directory examples
    "alt-cmd-shift-g": [
      "projects::OpenGitDirectory",
      {
        "directories": ["/path/to/your/projects"],
        "create_new_window": false
      }
    ],

    // Using environment variables
    "ctrl-cmd-g": [
      "projects::OpenGitDirectory",
      {
        "directories": ["$HOME/dev"],
        "create_new_window": false
      }
    ],

    // Multiple directories in a single action - scans all specified directories
    "alt-cmd-shift-m": [
      "projects::OpenGitDirectory",
      {
        "directories": ["$HOME/work", "$HOME/personal", "/usr/local/src"],
        "create_new_window": false
      }
    ],

    // Multiple project directories - you can create separate bindings for each
    "alt-cmd-1": [
      "projects::OpenGitDirectory",
      {
        "directories": ["$HOME/work"],
        "create_new_window": false
      }
    ],

    "alt-cmd-2": [
      "projects::OpenGitDirectory",
      {
        "directories": ["$HOME/personal"],
        "create_new_window": false
      }
    ],

    "alt-cmd-3": [
      "projects::OpenGitDirectory",
      {
        "directories": ["/usr/local/src"],
        "create_new_window": false
      }
    ],

    // Open in new window variants
    "alt-cmd-shift-1": [
      "projects::OpenGitDirectory",
      {
        "directories": ["$HOME/work"],
        "create_new_window": true
      }
    ],

    "alt-cmd-shift-2": [
      "projects::OpenGitDirectory",
      {
        "directories": ["$HOME/personal"],
        "create_new_window": true
      }
    ],

    // Multiple directories in new window
    "alt-cmd-shift-ctrl-m": [
      "projects::OpenGitDirectory",
      {
        "directories": ["$HOME/work", "$HOME/personal", "/usr/local/src"],
        "create_new_window": true
      }
    ]
  }
}
